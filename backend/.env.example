DATABASE_URL=postgres://inspectra:inspectra@localhost:5432/inspectra
PGSSLMODE=disable
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ORGANIZATION_NAME=Inspectria Demo

# Production email delivery. For Natro/XMail, use the mailbox settings shown
# in the Natro panel. Common setup:
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=reports@yourdomain.com
# MAIL_FROM="Inspectria Reports <reports@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_TO=info@yourdomain.com
PASSWORD_RESET_CODE_SECRET=replace-with-a-long-random-secret
ADMIN_USER_MANAGEMENT_URL=https://inspectria.com/login?admin=users
PUBLIC_APP_URL=https://inspectria.com

# iyzico subscription checkout. Use sandbox values first.
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_LOCALE=en
IYZICO_DEFAULT_EMAIL=
IYZICO_DEFAULT_GSM_NUMBER=
IYZICO_DEFAULT_IDENTITY_NUMBER=
IYZICO_DEFAULT_ADDRESS=
IYZICO_DEFAULT_CITY=Istanbul
IYZICO_DEFAULT_COUNTRY=Turkey
IYZICO_DEFAULT_ZIP_CODE=
IYZICO_STARTER_MONTHLY_PRICING_PLAN_REFERENCE_CODE=
IYZICO_STARTER_YEARLY_PRICING_PLAN_REFERENCE_CODE=
IYZICO_PROFESSIONAL_MONTHLY_PRICING_PLAN_REFERENCE_CODE=
IYZICO_PROFESSIONAL_YEARLY_PRICING_PLAN_REFERENCE_CODE=
IYZICO_ENTERPRISE_MONTHLY_PRICING_PLAN_REFERENCE_CODE=
IYZICO_ENTERPRISE_YEARLY_PRICING_PLAN_REFERENCE_CODE=
